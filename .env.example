# Локальные секреты — не коммитить. Скопируйте: cp .env.example .env

# PostgreSQL (сервис postgres в compose)
POSTGRES_USER=eis
POSTGRES_PASSWORD=change-me
POSTGRES_DB=eis
DATABASE_URL=postgres://eis:change-me@postgres:5432/eis?sslmode=disable

# Внутренние URL сервисов (docker network)
STORAGE_URL=http://storage:8081
SEARCH_URL=http://search:8082

# Порт UI на хосте (единственная публикация по умолчанию)
UI_PORT=8080

LOG_LEVEL=info

# --- ЕИС 44-ФЗ (секреты и сертификаты только в env / mount, не в git) ---
# Пути к сертификатам оставляйте пустыми, пока нет реальных файлов в контейнере.
EIS_44_SOAP_URL=https://int44-ttls-cert.zakupki.gov.ru/eis-integration/services/getDocsMis
EIS_SENDER_CODE=
EIS_44_TLS_CERT=
EIS_44_TLS_KEY=

# --- ЕИС 223-ФЗ ---
EIS_223_BASE_URL=https://int.zakupki.gov.ru/eis-integration/services/publishedInfo
EIS_223_LOGIN=
EIS_223_PASSWORD=

# Разрешённые хосты для скачивания архивов (через запятую)
EIS_DOWNLOAD_ALLOWLIST=zakupki.gov.ru,int.zakupki.gov.ru,int44-ttls-cert.zakupki.gov.ru
